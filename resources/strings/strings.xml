<strings>
    <!-- App name (referenced by manifest) -->
    <string id="AppName">Power Nap</string>

    <!-- Companion app settings titles -->
    <string id="NapDurationTitle">Nap Duration (min)</string>
    <string id="FallAsleepAllowanceTitle">Max time to fall asleep (min)</string>
    <string id="FallAsleepAllowancePrompt">The alarm rings at the latest this many minutes plus the nap duration after start, even if sleep is not detected. Falling asleep later shortens the nap.</string>
    <string id="AlarmTypeTitle">Alarm Type</string>
    <string id="HRDropTitle">HR Drop Threshold (BPM)</string>
    <string id="MotionSensTitle">Motion Sensitivity</string>

    <!-- Companion app settings list values -->
    <string id="VibrationOnly">Vibration only</string>
    <string id="ToneOnly">Nature sound only</string>
    <string id="VibrationAndTone">Vibration + nature sound (default)</string>
    <string id="Low">Low (restless sleepers)</string>
    <string id="Medium">Medium (default)</string>
    <string id="High">High (strict stillness)</string>

    <!-- On-screen text. The wording the watch shows lives here, not in the
         views; each hint is listed longest first, and the layout picks the
         longest variant that fits the screen it is drawn on. -->
    <string id="StartHintTouch">TAP to start</string>
    <string id="StartHintTouchShort">TAP</string>
    <string id="StartHintButton">START to begin</string>
    <string id="StartHintButtonShort">START</string>

    <!-- What a second BACK does, shown as a popup after the first one. One
         per thing that would be lost: the nap, the ringing alarm, the Stay
         Awake session. Longest first, as above. -->
    <string id="BackAgainNap">Press BACK again to end nap</string>
    <string id="BackAgainNapShort">BACK again to end nap</string>
    <string id="BackAgainNapTiny">BACK again: end</string>
    <string id="BackAgainNapTiniest">BACK x2: end</string>
    <string id="BackAgainAlarm">Press BACK again to stop alarm</string>
    <string id="BackAgainAlarmShort">BACK again to stop alarm</string>
    <string id="BackAgainAlarmTiny">BACK again: stop</string>
    <string id="BackAgainAlarmTiniest">BACK x2: stop</string>
    <string id="BackAgainSession">Press BACK again to end session</string>
    <string id="BackAgainSessionShort">BACK again to end session</string>
    <string id="BackAgainSessionTiny">BACK again: end</string>
    <string id="BackAgainSessionTiniest">BACK x2: end</string>
</strings>
